                                      FilterChip(selected = currentPreset == p, onClick = { storage.themePreset = p; onPresetChange(p) }, label = { Text(p.titleAr) })
                                  }
                              }
                              Text("اختر شعار السيارة في الشريط العلوي:", color = preset.primary, fontWeight = FontWeight.Bold)
                              Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                                  storage.availableBrands.forEach { b ->
                                      FilterChip(selected = brand == b, onClick = { brand = b; storage.carBrandName = b; onSettingsUpdated() }, label = { Text(b) })
                                  }
                              }
                          }
                      }
                      AppRoute.SHORTCUTS_MANAGER -> {
                          Card(colors = CardDefaults.cardColors(containerColor = preset.card.copy(alpha = 0.88f)), modifier = Modifier.fillMaxSize()) {
                              Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
                                  Text("إدارة اختصارات الشريط السفلي والتطبيقات المفضلة", style = MaterialTheme.typography.titleLarge, color = preset.primary)
                                  Text("عدد التطبيقات المفضلة المحفوظة حاليًا: ${storage.favoritePackages.size}", color = DesignTokens.TextPrimary)
                                  Button(onClick = { onNavigate(AppRoute.APPS_FAVORITES) }) { Text("فتح وتعديل التطبيقات المفضلة") }
                              }
                          }
                      }
                      AppRoute.DEVICE_COMPATIBILITY -> {
                          val reportRows = listOf(
                              "مستقبل الأقمار الصناعية GPS" to (if (hardware.hasGpsHardware) "SUPPORTED" else "NOT SUPPORTED"),
                              "وحدة البلوتوث والاتصال" to (if (hardware.hasBluetoothHardware) "SUPPORTED" else "NOT SUPPORTED"),
                              "مستشعر البوصلة المغناطيسي" to (if (hardware.hasCompassSensor) "SUPPORTED" else "NOT SUPPORTED"),
                              "كمبيوتر السيارة OBD2 (ELM327)" to "REQUIRES EXTERNAL HARDWARE",
                              "شريحة استقبال راديو FM الداخلي" to "REQUIRES VENDOR HARDWARE"
                          )
                          LazyColumn(Modifier.fillMaxSize(), verticalArrangement = Arrangement.spacedBy(6.dp)) {
                              items(reportRows) { (name, state) ->
                                  Surface(color = preset.card.copy(alpha = 0.88f), shape = RoundedCornerShape(12.dp), modifier = Modifier.fillMaxWidth()) {
                                      Row(Modifier.padding(12.dp), horizontalArrangement = Arrangement.SpaceBetween) {
                                          Text(name, color = DesignTokens.TextPrimary, fontWeight = FontWeight.Bold)
                                          Text(state, color = if (state == "SUPPORTED") DesignTokens.StatusSuccess else DesignTokens.AmberGold, fontWeight = FontWeight.Bold, fontSize = 12.sp)
                                      }
                                  }
                              }
                          }
                      }
                      else -> {
                          Card(colors = CardDefaults.cardColors(containerColor = preset.card.copy(alpha = 0.88f)), modifier = Modifier.fillMaxSize()) {
                              Column(Modifier.padding(18.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
                                  Text("CAR LAUNCHER UNIVERSAL", style = MaterialTheme.typography.headlineMedium, color = preset.primary)
                                  Text("الإصدار: 4.0.0 — Complete UI Redesign (25 Screens + 8 States)", color = DesignTokens.TextPrimary, fontWeight = FontWeight.Bold)
                                  Text("المعمارية: Kotlin + Jetpack Compose + Material 3 RTL + Offline-First Engine", color = DesignTokens.TextSecondary)
                              }
                          }
                      }
                  }
              }
          }

          @Composable
          private fun ToggleRowItem(label: String, checked: Boolean, onCheckedChange: (Boolean) -> Unit) {
              val preset = LocalCockpitPreset.current
              Surface(color = preset.card.copy(alpha = 0.88f), shape = RoundedCornerShape(12.dp), modifier = Modifier.fillMaxWidth()) {
                  Row(Modifier.padding(horizontal = 14.dp, vertical = 6.dp), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
                      Text(label, color = DesignTokens.TextPrimary, fontSize = 13.sp)
                      Switch(checked = checked, onCheckedChange = onCheckedChange)
                  }
              }
          }
          EOF

