          @Composable
          private fun PanoramicSpeedometerWithCar(speed: Int, unitText: String, modifier: Modifier = Modifier) {
              val preset = LocalCockpitPreset.current
              Box(modifier = modifier, contentAlignment = Alignment.Center) {
                  Canvas(modifier = Modifier.fillMaxSize().padding(2.dp)) {
                      val w = size.width; val h = size.height
                      val diameter = minOf(w * 0.88f, h * 0.96f)
                      val radius = diameter / 2f
                      val cx = w / 2f; val cy = h * 0.56f
                      val startAngle = 150f; val sweepAngle = 240f
                      val topLeft = Offset(cx - radius, cy - radius)

                      drawArc(Color(0xFF17374B), startAngle, sweepAngle, false, topLeft, Size(diameter, diameter), style = Stroke(6.dp.toPx(), cap = StrokeCap.Round))
                      val frac = (speed.coerceIn(0, 260) / 260f)
                      drawArc(Brush.sweepGradient(listOf(preset.primary, Color(0xFF38BDF8), preset.primary)), startAngle, sweepAngle * frac, false, topLeft, Size(diameter, diameter), style = Stroke(7.dp.toPx(), cap = StrokeCap.Round))

                      val paint = android.graphics.Paint().apply { color = android.graphics.Color.WHITE; textSize = 9.5.dp.toPx(); textAlign = android.graphics.Paint.Align.CENTER; isAntiAlias = true; typeface = android.graphics.Typeface.DEFAULT_BOLD }
                      for (i in 0..26) {
                          val stepSpeed = i * 10
                          val rad = Math.toRadians((startAngle + (i / 26f) * sweepAngle).toDouble())
                          val isMajor = stepSpeed % 20 == 0
                          val outerR = radius - 5.dp.toPx()
                          val innerR = outerR - if (isMajor) 8.dp.toPx() else 4.dp.toPx()
                          drawLine(if (stepSpeed <= speed) preset.primary else Color.White.copy(alpha = 0.7f), Offset(cx + (outerR * cos(rad)).toFloat(), cy + (outerR * sin(rad)).toFloat()), Offset(cx + (innerR * cos(rad)).toFloat(), cy + (innerR * sin(rad)).toFloat()), if (isMajor) 2.dp.toPx() else 1.dp.toPx())
                          if (isMajor) {
                              val textR = innerR - 12.dp.toPx()
                              drawContext.canvas.nativeCanvas.drawText(stepSpeed.toString(), cx + (textR * cos(rad)).toFloat(), cy + (textR * sin(rad)).toFloat() + 4.dp.toPx(), paint)
                          }
                      }

                      val carW = radius * 0.54f; val carH = radius * 0.32f
                      val carLeft = cx - carW / 2f; val carTop = cy + radius * 0.16f
                      drawRoundRect(Color.Black.copy(alpha = 0.55f), Offset(carLeft - 4.dp.toPx(), carTop + carH - 5.dp.toPx()), Size(carW + 8.dp.toPx(), 9.dp.toPx()), CornerRadius(8f, 8f))
                      drawRoundRect(Color(0xFF0F172A), Offset(carLeft + 2.dp.toPx(), carTop + carH * 0.65f), Size(carW * 0.18f, carH * 0.42f), CornerRadius(4f, 4f))
                      drawRoundRect(Color(0xFF0F172A), Offset(carLeft + carW * 0.82f - 2.dp.toPx(), carTop + carH * 0.65f), Size(carW * 0.18f, carH * 0.42f), CornerRadius(4f, 4f))
                      val bodyPath = Path().apply { moveTo(carLeft + carW * 0.18f, carTop); lineTo(carLeft + carW * 0.82f, carTop); lineTo(carLeft + carW, carTop + carH * 0.45f); lineTo(carLeft + carW, carTop + carH * 0.85f); lineTo(carLeft, carTop + carH * 0.85f); lineTo(carLeft, carTop + carH * 0.45f); close() }
                      drawPath(bodyPath, Color(0xFFF1F5F9))
                      val glassPath = Path().apply { moveTo(carLeft + carW * 0.23f, carTop + carH * 0.08f); lineTo(carLeft + carW * 0.77f, carTop + carH * 0.08f); lineTo(carLeft + carW * 0.88f, carTop + carH * 0.40f); lineTo(carLeft + carW * 0.12f, carTop + carH * 0.40f); close() }
                      drawPath(glassPath, Color(0xFF1E293B))
                      drawRoundRect(Color(0xFFEF4444), Offset(carLeft + carW * 0.06f, carTop + carH * 0.48f), Size(carW * 0.22f, carH * 0.16f), CornerRadius(4f, 4f))
                      drawRoundRect(Color(0xFFEF4444), Offset(carLeft + carW * 0.72f, carTop + carH * 0.48f), Size(carW * 0.22f, carH * 0.16f), CornerRadius(4f, 4f))
                      drawRoundRect(Color(0xFF0F172A), Offset(carLeft + carW * 0.38f, carTop + carH * 0.62f), Size(carW * 0.24f, carH * 0.16f), CornerRadius(3f, 3f))
                  }

                  Column(horizontalAlignment = Alignment.CenterHorizontally, modifier = Modifier.offset(y = (-12).dp)) {
                      Text("$speed", fontSize = 44.sp, fontWeight = FontWeight.Black, color = Color.White)
                      Text(unitText, fontSize = 12.sp, fontWeight = FontWeight.Bold, color = DesignTokens.TextSecondary)
                  }
              }
          }
