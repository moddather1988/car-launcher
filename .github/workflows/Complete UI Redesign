          // 8 & 9. شاشة التطبيقات المثبتة والمفضلة
          @Composable
          fun AppsGridScreen(onlyFavorites: Boolean, storage: LauncherStorage, stateCond: UiStateCondition) {
              val preset = LocalCockpitPreset.current; val context = LocalContext.current
              var query by remember { mutableStateOf("") }
              var favs by remember { mutableStateOf(storage.favoritePackages) }
              val allApps = remember {
                  val pm = context.packageManager
                  val intent = Intent(Intent.ACTION_MAIN, null).apply { addCategory(Intent.CATEGORY_LAUNCHER) }
                  pm.queryIntentActivities(intent, 0).filter { it.activityInfo.packageName != context.packageName }.map { it.loadLabel(pm).toString() to it.activityInfo.packageName }.sortedBy { it.first }
              }
              val displayed = allApps.filter { (!onlyFavorites || favs.contains(it.second)) && it.first.contains(query, true) }
              val effectiveCond = if (stateCond == UiStateCondition.NORMAL && displayed.isEmpty()) UiStateCondition.EMPTY_DATA else stateCond

              UnifiedStateRenderer(condition = effectiveCond, emptyMessage = if (onlyFavorites) "لم تقم بإضافة تطبيقات إلى المفضلة بعد (اضغط علامة النجمة بجانب أي تطبيق)." else "لا توجد تطبيقات مطابقة للبحث.") {
                  Column(Modifier.fillMaxSize(), verticalArrangement = Arrangement.spacedBy(8.dp)) {
                      OutlinedTextField(value = query, onValueChange = { query = it }, placeholder = { Text(if (onlyFavorites) "ابحث في التطبيقات المفضلة..." else "ابحث في جميع التطبيقات (${allApps.size})...") }, modifier = Modifier.fillMaxWidth(), singleLine = true)
                      LazyVerticalGrid(columns = GridCells.Adaptive(155.dp), verticalArrangement = Arrangement.spacedBy(8.dp), horizontalArrangement = Arrangement.spacedBy(8.dp), modifier = Modifier.weight(1f)) {
                          items(displayed) { (label, pkg) ->
                              val isFav = favs.contains(pkg)
                              Card(colors = CardDefaults.cardColors(containerColor = preset.card.copy(alpha = 0.88f)), border = BorderStroke(1.dp, if (isFav) DesignTokens.AmberGold else preset.border)) {
                                  Row(Modifier.padding(10.dp).fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
                                      Text(label, color = DesignTokens.TextPrimary, maxLines = 1, modifier = Modifier.weight(1f).clickable {
                                          context.packageManager.getLaunchIntentForPackage(pkg)?.let { it.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK); runCatching { context.startActivity(it) } }
                                      })
                                      IconButton(onClick = { favs = storage.toggleFavoriteApp(pkg) }, modifier = Modifier.size(26.dp)) {
                                          Icon(if (isFav) Icons.Default.Star else Icons.Default.StarBorder, null, tint = if (isFav) DesignTokens.AmberGold else DesignTokens.TextMuted)
                                      }
                                  }
                              }
                          }
                      }
                  }
              }
          }

