                                      Text("الرئيسية", color = Color.Black, fontWeight = FontWeight.Bold, fontSize = 11.sp)
                                  }
                              }
                          }
                      }

                      Box(modifier = Modifier.weight(1f).fillMaxWidth(), content = content)

                      // الشريط السفلي الزجاجي العريض المطابق للصورة الأولى
                      Surface(
