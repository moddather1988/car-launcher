name: Build Car Launcher Universal v4 Complete UI

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build-apk:
    runs-on: ubuntu-24.04

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Generate Complete 25-Screen UI System & Previews
        run: |
          rm -rf app build.gradle.kts settings.gradle.kts gradle.properties
          BASE="app/src/main/java/com/universal/carlauncher"
          mkdir -p "$BASE/core/designsystem" "$BASE/core/responsive" "$BASE/core/hardware" "$BASE/core/storage" "$BASE/domain/islamic" "$BASE/ui/components" "$BASE/ui/navigation" "$BASE/ui/screens" "$BASE/ui/previews"

          cat << 'EOF' > settings.gradle.kts
          pluginManagement {
              repositories { google(); mavenCentral(); gradlePluginPortal() }
          }
          dependencyResolutionManagement {
              repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
              repositories { google(); mavenCentral() }
          }
          rootProject.name = "CarLauncherUniversal"
          include(":app")
          EOF

          cat << 'EOF' > build.gradle.kts
          plugins {
              id("com.android.application") version "8.7.2" apply false
              id("org.jetbrains.kotlin.android") version "2.0.21" apply false
              id("org.jetbrains.kotlin.plugin.compose") version "2.0.21" apply false
          }
          EOF

          cat << 'EOF' > gradle.properties
          org.gradle.jvmargs=-Xmx3072m -Dfile.encoding=UTF-8
          org.gradle.parallel=true
          android.useAndroidX=true
          kotlin.code.style=official
          android.nonTransitiveRClass=true
          EOF

          cat << 'EOF' > app/build.gradle.kts
          plugins {
              id("com.android.application")
              id("org.jetbrains.kotlin.android")
              id("org.jetbrains.kotlin.plugin.compose")
          }
          android {
              namespace = "com.universal.carlauncher"
              compileSdk = 35
              defaultConfig {
                  applicationId = "com.universal.carlauncher"
                  minSdk = 26
                  targetSdk = 35
                  versionCode = 4
                  versionName = "4.0.0-CompleteUIRedesign"
              }
              buildTypes { debug { isMinifyEnabled = false } }
              compileOptions {
                  sourceCompatibility = JavaVersion.VERSION_17
                  targetCompatibility = JavaVersion.VERSION_17
              }
              kotlinOptions { jvmTarget = "17" }
              buildFeatures { compose = true }
          }
          dependencies {
              implementation("androidx.core:core-ktx:1.15.0")
              implementation("androidx.lifecycle:lifecycle-runtime-ktx:2.8.7")
              implementation("androidx.activity:activity-compose:1.9.3")
              implementation(platform("androidx.compose:compose-bom:2024.10.01"))
              implementation("androidx.compose.ui:ui")
              implementation("androidx.compose.ui:ui-graphics")
              implementation("androidx.compose.ui:ui-tooling-preview")
              debugImplementation("androidx.compose.ui:ui-tooling")
              implementation("androidx.compose.material3:material3")
              implementation("androidx.compose.material:material-icons-extended")
          }
          EOF

          cat << 'EOF' > app/src/main/AndroidManifest.xml
          <?xml version="1.0" encoding="utf-8"?>
          <manifest xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools">
              <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
              <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
              <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
              <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
              <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
              <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
              <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
              <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
              <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
              <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
              <uses-feature android:name="android.hardware.location.gps" android:required="false" />
              <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
              <uses-feature android:name="android.hardware.wifi" android:required="false" />
              <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
              <application
                  android:allowBackup="true"
                  android:label="CAR LAUNCHER UNIVERSAL"
                  android:supportsRtl="true"
                  android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
                  android:hardwareAccelerated="true">
                  <activity
                      android:name=".MainActivity"
                      android:exported="true"
                      android:launchMode="singleTask"
                      android:clearTaskOnLaunch="true"
                      android:stateNotNeeded="true"
                      android:screenOrientation="unspecified"
                      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|locale|layoutDirection">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN" />
                          <category android:name="android.intent.category.LAUNCHER" />
                          <category android:name="android.intent.category.HOME" />
                          <category android:name="android.intent.category.DEFAULT" />
                          <category android:name="android.intent.category.CAR_DOCK" />
                          <category android:name="android.intent.category.CAR_MODE" />
                      </intent-filter>
                  </activity>
              </application>
          </manifest>
          EOF

          # 1. DesignTokens & Theme
          cat << 'EOF' > "$BASE/core/designsystem/DesignTokens.kt"
          package com.universal.carlauncher.core.designsystem
          import androidx.compose.ui.graphics.Color
          import androidx.compose.ui.unit.dp

          enum class CockpitThemePreset(
              val titleAr: String, val background: Color, val surface: Color,
              val card: Color, val cardElevated: Color, val primary: Color,
              val secondary: Color, val border: Color
          ) {
              PANORAMIC_TEAL("بانورامي تيفاني (الأصلي)", Color(0xFF061520), Color(0xFF0A2130), Color(0xFF0D2638), Color(0xFF13354C), Color(0xFF2DD4BF), Color(0xFFF59E0B), Color(0xFF285973)),
              MERCEDES_OBSIDIAN("مرسيدس ليل داكن", Color(0xFF05070B), Color(0xFF0C1018), Color(0xFF131926), Color(0xFF1B2436), Color(0xFF00B4D8), Color(0xFFF59E0B), Color(0xFF233047)),
              BMW_M_PERFORMANCE("بي إم دبليو رياضي", Color(0xFF07080C), Color(0xFF10131C), Color(0xFF171C29), Color(0xFF21283A), Color(0xFF38BDF8), Color(0xFFEF4444), Color(0xFF2D3748)),
              AUDI_VIRTUAL_COCKPIT("أودي كوكبيت", Color(0xFF08090A), Color(0xFF121417), Color(0xFF1A1D22), Color(0xFF242930), Color(0xFF00F5D4), Color(0xFFF59E0B), Color(0xFF2E343D)),
              PORSCHE_TAYCAN("بورش تايكان", Color(0xFF040A0E), Color(0xFF0A161F), Color(0xFF102230), Color(0xFF173145), Color(0xFF38BDF8), Color(0xFFF59E0B), Color(0xFF1E425E))
          }

          object DesignTokens {
              val TextPrimary = Color(0xFFF8FAFC)
              val TextSecondary = Color(0xFFCBD5E1)
              val TextMuted = Color(0xFF94A3B8)
              val AmberGold = Color(0xFFF59E0B)
              val StatusSuccess = Color(0xFF10B981)
              val StatusWarning = Color(0xFFF59E0B)
              val StatusDanger = Color(0xFFEF4444)
              val RadiusS = 10.dp
              val RadiusM = 16.dp
              val RadiusL = 22.dp
              val RadiusPill = 50.dp
          }
          EOF

          cat << 'EOF' > "$BASE/core/designsystem/CarLauncherTheme.kt"
          package com.universal.carlauncher.core.designsystem
          import androidx.compose.material3.*
          import androidx.compose.runtime.*
          import androidx.compose.ui.platform.LocalLayoutDirection
          import androidx.compose.ui.text.TextStyle
          import androidx.compose.ui.text.font.FontFamily
          import androidx.compose.ui.text.font.FontWeight
          import androidx.compose.ui.unit.LayoutDirection
          import androidx.compose.ui.unit.sp

          val LocalCockpitPreset = staticCompositionLocalOf { CockpitThemePreset.PANORAMIC_TEAL }

          @Composable
          fun CarLauncherTheme(preset: CockpitThemePreset = CockpitThemePreset.PANORAMIC_TEAL, fontScaleMultiplier: Float = 1.0f, content: @Composable () -> Unit) {
              val colors = darkColorScheme(primary = preset.primary, secondary = preset.secondary, background = preset.background, surface = preset.surface, surfaceVariant = preset.card, onBackground = DesignTokens.TextPrimary, onSurface = DesignTokens.TextPrimary, error = DesignTokens.StatusDanger)
              val typography = Typography(
                  displayLarge = TextStyle(fontFamily = FontFamily.SansSerif, fontWeight = FontWeight.Black, fontSize = (50 * fontScaleMultiplier).sp),
                  headlineMedium = TextStyle(fontFamily = FontFamily.SansSerif, fontWeight = FontWeight.Bold, fontSize = (22 * fontScaleMultiplier).sp),
                  titleLarge = TextStyle(fontFamily = FontFamily.SansSerif, fontWeight = FontWeight.Bold, fontSize = (17 * fontScaleMultiplier).sp),
                  titleMedium = TextStyle(fontFamily = FontFamily.SansSerif, fontWeight = FontWeight.SemiBold, fontSize = (14 * fontScaleMultiplier).sp),
                  bodyLarge = TextStyle(fontFamily = FontFamily.SansSerif, fontWeight = FontWeight.Medium, fontSize = (13 * fontScaleMultiplier).sp),
                  labelMedium = TextStyle(fontFamily = FontFamily.SansSerif, fontWeight = FontWeight.Medium, fontSize = (11 * fontScaleMultiplier).sp)
              )
              CompositionLocalProvider(LocalLayoutDirection provides LayoutDirection.Rtl, LocalCockpitPreset provides preset) {
                  MaterialTheme(colorScheme = colors, typography = typography, content = content)
              }
          }
          EOF

          # 2. Responsive Engine
          cat << 'EOF' > "$BASE/core/responsive/ResponsiveWindowEngine.kt"
          package com.universal.carlauncher.core.responsive
          import android.content.res.Configuration
          import androidx.compose.runtime.*
          import androidx.compose.ui.platform.LocalConfiguration
          import androidx.compose.ui.unit.Dp
          import androidx.compose.ui.unit.dp

          data class ResponsiveLayoutMetrics(val isLandscape: Boolean, val widthDp: Int, val heightDp: Int, val scaleFactor: Float, val outerPadding: Dp)

          @Composable
          fun rememberResponsiveMetrics(): ResponsiveLayoutMetrics {
              val config = LocalConfiguration.current
              val w = config.screenWidthDp.coerceAtLeast(320)
              val h = config.screenHeightDp.coerceAtLeast(240)
              val isLandscape = config.orientation == Configuration.ORIENTATION_LANDSCAPE || w >= h
              return remember(w, h, isLandscape) {
                  val scale = when { h <= 380 -> 0.78f; h <= 440 -> 0.86f; h <= 540 -> 0.95f; else -> 1.04f }
                  ResponsiveLayoutMetrics(isLandscape, w, h, scale, if (h <= 430) 6.dp else 10.dp)
              }
          }
          EOF

          # 3. Storage & Preferences
          cat << 'EOF' > "$BASE/core/storage/LauncherStorage.kt"
          package com.universal.carlauncher.core.storage
          import android.content.Context
          import com.universal.carlauncher.core.designsystem.CockpitThemePreset

          class LauncherStorage(context: Context) {
              private val prefs = context.getSharedPreferences("car_launcher_v4_prefs", Context.MODE_PRIVATE)
              val availableBrands = listOf("Ford", "KIA", "Mercedes", "BMW", "Toyota", "Hyundai")

              var themePreset: CockpitThemePreset
                  get() = runCatching { CockpitThemePreset.valueOf(prefs.getString("theme", CockpitThemePreset.PANORAMIC_TEAL.name)!!) }.getOrDefault(CockpitThemePreset.PANORAMIC_TEAL)
                  set(value) = prefs.edit().putString("theme", value.name).apply()

              var carBrandName: String
                  get() = prefs.getString("car_brand", "Ford") ?: "Ford"
                  set(value) = prefs.edit().putString("car_brand", value).apply()

              fun cycleCarBrand(): String {
                  val next = availableBrands[(availableBrands.indexOf(carBrandName) + 1) % availableBrands.size]
                  carBrandName = next
                  return next
              }

              var use24HourFormat: Boolean
                  get() = prefs.getBoolean("use_24h", false)
                  set(value) = prefs.edit().putBoolean("use_24h", value).apply()

              var showSeconds: Boolean
                  get() = prefs.getBoolean("show_sec", false)
                  set(value) = prefs.edit().putBoolean("show_sec", value).apply()

              var showHijriDate: Boolean
                  get() = prefs.getBoolean("show_hijri", true)
                  set(value) = prefs.edit().putBoolean("show_hijri", value).apply()

              var useMphUnit: Boolean
                  get() = prefs.getBoolean("use_mph", false)
                  set(value) = prefs.edit().putBoolean("use_mph", value).apply()

              var speedAlertLimit: Int
                  get() = prefs.getInt("speed_limit", 120)
                  set(value) = prefs.edit().putInt("speed_limit", value).apply()

              var tasbeehCount: Int
                  get() = prefs.getInt("tasbeeh_count", 0)
                  set(value) = prefs.edit().putInt("tasbeeh_count", value).apply()

              var tasbeehTarget: Int
                  get() = prefs.getInt("tasbeeh_target", 100)
                  set(value) = prefs.edit().putInt("tasbeeh_target", value).apply()

              var showPrayerPanel: Boolean
                  get() = prefs.getBoolean("show_prayer_panel", true)
                  set(value) = prefs.edit().putBoolean("show_prayer_panel", value).apply()

              var showTripPanel: Boolean
                  get() = prefs.getBoolean("show_trip_panel", true)
                  set(value) = prefs.edit().putBoolean("show_trip_panel", value).apply()

              var showMusicDock: Boolean
                  get() = prefs.getBoolean("show_music_dock", true)
                  set(value) = prefs.edit().putBoolean("show_music_dock", value).apply()

              var favoritePackages: Set<String>
                  get() = prefs.getStringSet("fav_pkgs", emptySet()) ?: emptySet()
                  set(value) = prefs.edit().putStringSet("fav_pkgs", value).apply()

              fun toggleFavoriteApp(pkg: String): Set<String> {
                  val current = favoritePackages.toMutableSet()
                  if (current.contains(pkg)) current.remove(pkg) else current.add(pkg)
                  favoritePackages = current
                  return current
              }

              fun resetAllToDefaults() = prefs.edit().clear().apply()
          }
          EOF

          # 4. Hardware Service
          cat << 'EOF' > "$BASE/core/hardware/VehicleHardwareService.kt"
          package com.universal.carlauncher.core.hardware
          import android.Manifest
          import android.bluetooth.BluetoothManager
          import android.content.Context
          import android.content.pm.PackageManager
          import android.hardware.Sensor
          import android.hardware.SensorManager
          import android.location.LocationManager
          import android.net.ConnectivityManager
          import android.net.NetworkCapabilities
          import androidx.core.content.ContextCompat

          data class HardwareDiagnosticReport(
              val hasGpsHardware: Boolean = true,
              val hasLocationPermission: Boolean = true,
              val isGpsEnabled: Boolean = true,
              val hasBluetoothHardware: Boolean = true,
              val isBluetoothEnabled: Boolean = true,
              val isInternetConnected: Boolean = true,
              val hasCompassSensor: Boolean = true,
              val hasAmbientTempSensor: Boolean = false
          )

          class VehicleHardwareService(private val context: Context) {
              fun inspectHardware(): HardwareDiagnosticReport {
                  val pm = context.packageManager
                  val hasGps = pm.hasSystemFeature(PackageManager.FEATURE_LOCATION_GPS)
                  val hasPerm = ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED
                  val lm = context.getSystemService(Context.LOCATION_SERVICE) as? LocationManager
                  val gpsOn = runCatching { lm?.isProviderEnabled(LocationManager.GPS_PROVIDER) == true }.getOrDefault(false)
                  val hasBt = pm.hasSystemFeature(PackageManager.FEATURE_BLUETOOTH)
                  val bm = context.getSystemService(Context.BLUETOOTH_SERVICE) as? BluetoothManager
                  val btOn = runCatching { bm?.adapter?.isEnabled == true }.getOrDefault(false)
                  val cm = context.getSystemService(Context.CONNECTIVITY_SERVICE) as? ConnectivityManager
                  val caps = cm?.getNetworkCapabilities(cm.activeNetwork)
                  val sm = context.getSystemService(Context.SENSOR_SERVICE) as? SensorManager
                  val hasCompass = sm?.getDefaultSensor(Sensor.TYPE_MAGNETIC_FIELD) != null
                  val hasTemp = sm?.getDefaultSensor(Sensor.TYPE_AMBIENT_TEMPERATURE) != null
                  return HardwareDiagnosticReport(hasGps, hasPerm, gpsOn, hasBt, btOn, caps != null, hasCompass, hasTemp)
              }
          }
          EOF

          # 5. Offline Prayer Engine
          cat << 'EOF' > "$BASE/domain/islamic/OfflinePrayerEngine.kt"
          package com.universal.carlauncher.domain.islamic
          import java.util.*
          import kotlin.math.*

          data class DailyPrayerSchedule(
              val fajr: String, val sunrise: String, val dhuhr: String, val asr: String, val maghrib: String, val isha: String,
              val nextPrayerName: String, val nextPrayerTime: String, val remainingCountdownText: String, val qiblaDegrees: Int
          )

          object OfflinePrayerEngine {
              fun calculate(lat: Double = 30.0444, lon: Double = 31.2357): DailyPrayerSchedule {
                  val cal = Calendar.getInstance()
                  val tzHours = TimeZone.getDefault().getOffset(cal.timeInMillis) / 3600000.0
                  val jd = julianDate(cal.get(Calendar.YEAR), cal.get(Calendar.MONTH) + 1, cal.get(Calendar.DAY_OF_MONTH)) - lon / 360.0
                  val d = jd - 2451545.0
                  val g = fixAngle(357.529 + 0.98560028 * d)
                  val q = fixAngle(280.459 + 0.98564736 * d)
                  val l = fixAngle(q + 1.915 * sin(Math.toRadians(g)) + 0.020 * sin(Math.toRadians(2 * g)))
                  val e = 23.439 - 0.00000036 * d
                  val decl = Math.toDegrees(asin(sin(Math.toRadians(e)) * sin(Math.toRadians(l))))
                  val ra = Math.toDegrees(atan2(cos(Math.toRadians(e)) * sin(Math.toRadians(l)), cos(Math.toRadians(l)))) / 15.0
                  val dhuhrH = fixHour(12.0 + tzHours - lon / 15.0 - (q / 15.0 - fixHour(ra)))
                  val sunriseH = dhuhrH - sunAngleTime(0.833, lat, decl)
                  val sunsetH = dhuhrH + sunAngleTime(0.833, lat, decl)
                  val fajrH = dhuhrH - sunAngleTime(19.5, lat, decl)
                  val ishaH = dhuhrH + sunAngleTime(17.5, lat, decl)
                  val asrAngle = -Math.toDegrees(atan(1.0 / (1.0 + tan(Math.toRadians(abs(lat - decl))))))
                  val asrH = dhuhrH + sunAngleTime(-asrAngle, lat, decl)

                  val nowH = cal.get(Calendar.HOUR_OF_DAY) + cal.get(Calendar.MINUTE) / 60.0
                  val list = listOf("الفجر" to fajrH, "الظهر" to dhuhrH, "العصر" to asrH, "المغرب" to sunsetH, "العشاء" to ishaH)
                  val next = list.firstOrNull { it.second > nowH } ?: ("الفجر" to (fajrH + 24.0))
                  val diff = (next.second - nowH).coerceAtLeast(0.0)
                  val remH = floor(diff).toInt()
                  val remM = floor((diff - remH) * 60.0).toInt()

                  val mLat = Math.toRadians(21.4225); val mLon = Math.toRadians(39.8262)
                  val uLat = Math.toRadians(lat); val uLon = Math.toRadians(lon)
                  val qibla = ((Math.toDegrees(atan2(sin(mLon - uLon), cos(uLat) * tan(mLat) - sin(uLat) * cos(mLon - uLon))) + 360.0) % 360.0).toInt()

                  return DailyPrayerSchedule(
                      format12h(fajrH), format12h(sunriseH), format12h(dhuhrH), format12h(asrH), format12h(sunsetH), format12h(ishaH),
                      next.first, format12h(next.second % 24.0), "متبقي $remH س و $remM د", qibla
                  )
              }
              private fun sunAngleTime(angle: Double, lat: Double, decl: Double): Double {
                  val c = ((-sin(Math.toRadians(angle)) - sin(Math.toRadians(lat)) * sin(Math.toRadians(decl))) / (cos(Math.toRadians(lat)) * cos(Math.toRadians(decl)))).coerceIn(-1.0, 1.0)
                  return Math.toDegrees(acos(c)) / 15.0
              }
              private fun julianDate(y: Int, m: Int, d: Int): Double {
                  var yr = y; var mo = m; if (mo <= 2) { yr -= 1; mo += 12 }
                  val a = floor(yr / 100.0)
                  return floor(365.25 * (yr + 4716)) + floor(30.6001 * (mo + 1)) + d + (2 - a + floor(a / 4.0)) - 1524.5
              }
              private fun fixAngle(a: Double) = a - 360.0 * floor(a / 360.0)
              private fun fixHour(a: Double) = a - 24.0 * floor(a / 24.0)
              private fun format12h(time: Double): String {
                  val t = fixHour(time + 0.5 / 60.0)
                  val h24 = floor(t).toInt(); val m = floor((t - h24) * 60.0).toInt()
                  val s = if (h24 < 12) "ص" else "م"
                  val h12 = if (h24 == 0) 12 else if (h24 > 12) h24 - 12 else h24
                  return String.format(Locale.US, "%d:%02d %s", h12, m, s)
              }
          }
          EOF

          # 6. Unified 8-State Handler Component
          cat << 'EOF' > "$BASE/ui/components/StateViews.kt"
          package com.universal.carlauncher.ui.components
          import androidx.compose.foundation.*
          import androidx.compose.foundation.layout.*
          import androidx.compose.foundation.lazy.LazyRow
          import androidx.compose.foundation.lazy.items
          import androidx.compose.foundation.shape.RoundedCornerShape
          import androidx.compose.material.icons.Icons
          import androidx.compose.material.icons.filled.*
          import androidx.compose.material3.*
          import androidx.compose.runtime.Composable
          import androidx.compose.ui.Alignment
          import androidx.compose.ui.Modifier
          import androidx.compose.ui.graphics.Color
          import androidx.compose.ui.text.font.FontWeight
          import androidx.compose.ui.text.style.TextAlign
          import androidx.compose.ui.unit.dp
          import androidx.compose.ui.unit.sp
          import com.universal.carlauncher.core.designsystem.DesignTokens
          import com.universal.carlauncher.core.designsystem.LocalCockpitPreset

          enum class UiStateCondition(val titleAr: String) {
              NORMAL("الحالة الطبيعية"),
              EMPTY_DATA("عدم وجود بيانات"),
              NO_INTERNET("عدم وجود إنترنت"),
              PERMISSION_DENIED("عدم منح الصلاحيات"),
              SENSOR_UNAVAILABLE("عدم توفر المستشعر"),
              LOADING("جاري التحميل"),
              ERROR("حدوث خطأ"),
              DEVICE_INCOMPATIBLE("عدم توافق الجهاز")
          }

          @Composable
          fun StateConditionSelectorBar(
              currentState: UiStateCondition,
              onSelectState: (UiStateCondition) -> Unit
          ) {
              val preset = LocalCockpitPreset.current
              LazyRow(
                  modifier = Modifier.fillMaxWidth().padding(vertical = 2.dp),
                  horizontalArrangement = Arrangement.spacedBy(6.dp)
              ) {
                  items(UiStateCondition.entries) { cond ->
                      val selected = cond == currentState
                      Surface(
                          color = if (selected) preset.primary.copy(alpha = 0.25f) else preset.card.copy(alpha = 0.75f),
                          shape = RoundedCornerShape(50),
                          border = BorderStroke(1.dp, if (selected) preset.primary else preset.border),
                          modifier = Modifier.clickable { onSelectState(cond) }
                      ) {
                          Text(
                              text = cond.titleAr,
                              fontSize = 10.sp,
                              color = if (selected) preset.primary else DesignTokens.TextSecondary,
                              fontWeight = if (selected) FontWeight.Bold else FontWeight.Normal,
                              modifier = Modifier.padding(horizontal = 10.dp, vertical = 4.dp)
                          )
                      }
                  }
              }
          }

          @Composable
          fun UnifiedStateRenderer(
              condition: UiStateCondition,
              emptyMessage: String = "لا توجد بيانات متاحة للعرض حاليًا في هذا القسم.",
              sensorMessage: String = "المستشعر المطلوب لهذه الوظيفة غير متوفر في شاشة السيارة الحالية.",
              incompatibleMessage: String = "هذا الجهاز لا يدعم هذه الميزة عتاديًا (Requires Hardware Adapter).",
              onRetryOrRequestPermission: () -> Unit = {},
              normalContent: @Composable () -> Unit
          ) {
              val preset = LocalCockpitPreset.current
              if (condition == UiStateCondition.NORMAL) {
                  normalContent()
                  return
