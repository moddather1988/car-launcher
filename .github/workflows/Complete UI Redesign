          # 11. MainActivity.kt (Full Router connecting all 25 screens & BackStack)
          cat << 'EOF' > "$BASE/MainActivity.kt"
          package com.universal.carlauncher
          import android.Manifest
          import android.annotation.SuppressLint
          import android.content.ContentUris
          import android.content.Context
          import android.location.*
          import android.media.MediaPlayer
          import android.os.*
          import android.provider.MediaStore
          import android.view.WindowManager
          import androidx.activity.*
          import androidx.activity.compose.rememberLauncherForActivityResult
          import androidx.activity.compose.setContent
          import androidx.activity.result.contract.ActivityResultContracts
          import androidx.compose.foundation.layout.*
          import androidx.compose.runtime.*
          import androidx.compose.ui.Modifier
          import androidx.core.view.*
          import com.universal.carlauncher.core.designsystem.CarLauncherTheme
          import com.universal.carlauncher.core.hardware.VehicleHardwareService
          import com.universal.carlauncher.core.responsive.rememberResponsiveMetrics
          import com.universal.carlauncher.core.storage.LauncherStorage
          import com.universal.carlauncher.domain.islamic.OfflinePrayerEngine
          import com.universal.carlauncher.ui.components.StateConditionSelectorBar
          import com.universal.carlauncher.ui.components.UiStateCondition
          import com.universal.carlauncher.ui.navigation.*
          import com.universal.carlauncher.ui.screens.*
          import kotlinx.coroutines.delay
          import java.time.LocalDateTime
          import java.time.chrono.HijrahDate
          import java.time.format.DateTimeFormatter
          import java.time.temporal.ChronoField
          import java.util.Locale

          class MainActivity : ComponentActivity() {
              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)
                  window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
                  enableImmersiveMode()
                  setContent { CarLauncherRootApp() }
              }
              override fun onWindowFocusChanged(hasFocus: Boolean) { super.onWindowFocusChanged(hasFocus); if (hasFocus) enableImmersiveMode() }
              private fun enableImmersiveMode() {
                  WindowCompat.setDecorFitsSystemWindows(window, false)
                  WindowInsetsControllerCompat(window, window.decorView).apply {
                      hide(WindowInsetsCompat.Type.systemBars())
                      systemBarsBehavior = WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
                  }
              }
          }

          @SuppressLint("MissingPermission")
          @Composable
          fun CarLauncherRootApp() {
              val context = androidx.compose.ui.platform.LocalContext.current
              val storage = remember { LauncherStorage(context) }
              val hardwareService = remember { VehicleHardwareService(context) }
              val metrics = rememberResponsiveMetrics()

              var currentPreset by remember { mutableStateOf(storage.themePreset) }
              var settingsTick by remember { mutableIntStateOf(0) }
              val backStack = remember { mutableStateListOf(AppRoute.DASHBOARD) }
              val currentRoute = backStack.lastOrNull() ?: AppRoute.DASHBOARD
              var activeUiCondition by remember { mutableStateOf(UiStateCondition.NORMAL) }

              fun navigateTo(route: AppRoute) {
                  activeUiCondition = UiStateCondition.NORMAL
                  if (route == AppRoute.DASHBOARD) {
                      backStack.clear()
                      backStack.add(AppRoute.DASHBOARD)
                  } else if (backStack.lastOrNull() != route) {
                      backStack.add(route)
                  }
              }

              fun popBack() {
                  if (backStack.size > 1) backStack.removeAt(backStack.lastIndex)
              }

              var timeFormatted by remember { mutableStateOf("07:52") }
              var amPmArabic by remember { mutableStateOf("ص") }
              var gregorianDate by remember { mutableStateOf("") }
              var hijriDate by remember { mutableStateOf("") }
              var tripStartRealtime by remember { mutableLongStateOf(SystemClock.elapsedRealtime()) }
              var durationMinutes by remember { mutableIntStateOf(0) }

              var liveSpeedKmh by remember { mutableStateOf<Int?>(null) }
              var accuracyMeters by remember { mutableStateOf<Int?>(null) }
              var distanceKm by remember { mutableFloatStateOf(0f) }
              var maxSpeedKmh by remember { mutableIntStateOf(0) }
              var bearingDeg by remember { mutableIntStateOf(136) }
              var currentLat by remember { mutableStateOf<Double?>(null) }
              var currentLon by remember { mutableStateOf<Double?>(null) }
              var lastLoc by remember { mutableStateOf<Location?>(null) }
              var hardwareReport by remember { mutableStateOf(hardwareService.inspectHardware()) }

              var audioTracks by remember { mutableStateOf<List<LocalAudioTrack>>(emptyList()) }
              var currentTrackIdx by remember { mutableIntStateOf(0) }
              var isPlayingMusic by remember { mutableStateOf(false) }
              val mediaPlayer = remember { MediaPlayer() }

              fun loadDeviceAudio() {
                  val list = mutableListOf<LocalAudioTrack>()
                  runCatching {
                      context.contentResolver.query(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, arrayOf(MediaStore.Audio.Media._ID, MediaStore.Audio.Media.TITLE, MediaStore.Audio.Media.ARTIST), "${MediaStore.Audio.Media.IS_MUSIC} != 0", null, "${MediaStore.Audio.Media.TITLE} ASC")?.use { c ->
                          val idC = c.getColumnIndexOrThrow(MediaStore.Audio.Media._ID)
                          val tC = c.getColumnIndexOrThrow(MediaStore.Audio.Media.TITLE)
                          val aC = c.getColumnIndexOrThrow(MediaStore.Audio.Media.ARTIST)
                          while (c.moveToNext() && list.size < 100) {
                              val id = c.getLong(idC)
                              list.add(LocalAudioTrack(id, c.getString(tC) ?: "مقطع صوتي", c.getString(aC) ?: "MyCar Audio", ContentUris.withAppendedId(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, id)))
                          }
                      }
                  }
                  audioTracks = list
              }

              fun playTrackAt(index: Int) {
                  val track = audioTracks.getOrNull(index) ?: return
                  runCatching { mediaPlayer.reset(); mediaPlayer.setDataSource(context, track.uri); mediaPlayer.prepare(); mediaPlayer.start(); currentTrackIdx = index; isPlayingMusic = true }
              }

              val permLauncher = rememberLauncherForActivityResult(ActivityResultContracts.RequestMultiplePermissions()) {
                  hardwareReport = hardwareService.inspectHardware(); loadDeviceAudio()
              }

              LaunchedEffect(Unit) {
                  val perms = mutableListOf(Manifest.permission.ACCESS_FINE_LOCATION, Manifest.permission.ACCESS_COARSE_LOCATION)
                  if (Build.VERSION.SDK_INT >= 33) perms.add(Manifest.permission.READ_MEDIA_AUDIO) else perms.add(Manifest.permission.READ_EXTERNAL_STORAGE)
                  permLauncher.launch(perms.toTypedArray()); loadDeviceAudio()
              }

              DisposableEffect(hardwareReport.hasLocationPermission) {
                  val lm = context.getSystemService(Context.LOCATION_SERVICE) as? LocationManager
                  val listener = LocationListener { loc ->
                      val spd = if (loc.hasSpeed()) (loc.speed * 3.6f).toInt() else 0
                      liveSpeedKmh = spd; accuracyMeters = loc.accuracy.toInt(); currentLat = loc.latitude; currentLon = loc.longitude
                      if (loc.hasBearing()) bearingDeg = loc.bearing.toInt()
                      if (spd > maxSpeedKmh) maxSpeedKmh = spd
                      lastLoc?.let { prev -> val d = prev.distanceTo(loc); if (d > 3f && loc.accuracy <= 35f) distanceKm += (d / 1000f) }
                      lastLoc = loc
                  }
                  if (hardwareReport.hasLocationPermission && lm != null) runCatching { lm.requestLocationUpdates(LocationManager.GPS_PROVIDER, 1000L, 1f, listener) }
                  onDispose { runCatching { lm?.removeUpdates(listener) }; runCatching { mediaPlayer.release() } }
              }

              LaunchedEffect(settingsTick) {
                  val hijriMonths = arrayOf("محرم", "صفر", "ربيع الأول", "ربيع الآخر", "جمادى الأولى", "جمادى الآخرة", "رجب", "شعبان", "رمضان", "شوال", "ذو القعدة", "ذو الحجة")
                  var sec = 0
                  while (true) {
                      val now = LocalDateTime.now()
                      timeFormatted = now.format(DateTimeFormatter.ofPattern(if (storage.use24HourFormat) "HH:mm" else "hh:mm", Locale.US))
                      amPmArabic = if (now.hour < 12) "ص" else "م"
                      gregorianDate = now.format(DateTimeFormatter.ofPattern("EEEE، d MMMM yyyy", Locale("ar", "EG")))
                      val hijri = HijrahDate.now()
                      hijriDate = "${hijri.get(ChronoField.DAY_OF_MONTH)} ${hijriMonths[(hijri.get(ChronoField.MONTH_OF_YEAR) - 1).coerceIn(0, 11)]} ${hijri.get(ChronoField.YEAR)} هـ"
                      durationMinutes = ((SystemClock.elapsedRealtime() - tripStartRealtime) / 60000L).toInt()
                      if (sec % 4 == 0) hardwareReport = hardwareService.inspectHardware()
                      sec++; delay(1000L)
                  }
              }

              val prayers = remember(currentLat, currentLon, timeFormatted) { OfflinePrayerEngine.calculate(currentLat ?: 30.0444, currentLon ?: 31.2357) }
              val telemetry = LiveDrivingTelemetry(liveSpeedKmh, accuracyMeters, distanceKm, maxSpeedKmh, durationMinutes, bearingDeg)

              CarLauncherTheme(preset = currentPreset, fontScaleMultiplier = metrics.scaleFactor) {
                  CockpitNavigationShell(
                      currentRoute = currentRoute,
                      onNavigate = { navigateTo(it) },
                      onBack = { popBack() }
                  ) {
                      if (currentRoute == AppRoute.DASHBOARD) {
                          DashboardScreen(
                              metrics, timeFormatted, amPmArabic, gregorianDate, hijriDate, telemetry, hardwareReport, prayers,
                              audioTracks.getOrNull(currentTrackIdx)?.title ?: "Evening Drive QA",
                              audioTracks.getOrNull(currentTrackIdx)?.artist ?: "MyCar Audio Test",
                              isPlayingMusic, storage,
                              onToggleMusicPlay = { if (audioTracks.isEmpty()) loadDeviceAudio(); if (isPlayingMusic) { runCatching { mediaPlayer.pause() }; isPlayingMusic = false } else if (audioTracks.isNotEmpty()) playTrackAt(currentTrackIdx) },
                              onNextTrack = { if (audioTracks.isNotEmpty()) playTrackAt((currentTrackIdx + 1) % audioTracks.size) },
                              onPrevTrack = { if (audioTracks.isNotEmpty()) playTrackAt((currentTrackIdx - 1 + audioTracks.size) % audioTracks.size) },
                              onResetTrip = { distanceKm = 0f; maxSpeedKmh = 0; tripStartRealtime = SystemClock.elapsedRealtime() },
                              onNavigateTo = { navigateTo(it) },
                              onRequestGpsPermission = { permLauncher.launch(arrayOf(Manifest.permission.ACCESS_FINE_LOCATION, Manifest.permission.ACCESS_COARSE_LOCATION)) }
                          )
                      } else {
                          Column(Modifier.fillMaxSize()) {
                              StateConditionSelectorBar(currentState = activeUiCondition, onSelectState = { activeUiCondition = it })
                              Box(Modifier.weight(1f).fillMaxWidth()) {
                                  when (currentRoute) {
                                      AppRoute.NAVIGATION -> NavigationMapScreen(telemetry, currentLat, currentLon, activeUiCondition)
                                      AppRoute.WEATHER -> WeatherDetailScreen(hardwareReport, activeUiCondition)
                                      AppRoute.MUSIC_PLAYER -> MusicPlayerFullScreen(
                                          audioTracks, currentTrackIdx, isPlayingMusic,
                                          onTogglePlay = { if (isPlayingMusic) { runCatching { mediaPlayer.pause() }; isPlayingMusic = false } else if (audioTracks.isNotEmpty()) playTrackAt(currentTrackIdx) },
                                          onNext = { if (audioTracks.isNotEmpty()) playTrackAt((currentTrackIdx + 1) % audioTracks.size) },
                                          onPrev = { if (audioTracks.isNotEmpty()) playTrackAt((currentTrackIdx - 1 + audioTracks.size) % audioTracks.size) },
                                          onOpenSongList = { navigateTo(AppRoute.SONG_LIST) },
                                          stateCond = activeUiCondition
                                      )
                                      AppRoute.SONG_LIST -> SongListScreen(audioTracks, currentTrackIdx, { playTrackAt(it); navigateTo(AppRoute.MUSIC_PLAYER) }, { loadDeviceAudio() }, activeUiCondition)
                                      AppRoute.RADIO -> RadioFmScreen(activeUiCondition)
                                      AppRoute.PHONE_DIALPAD -> PhoneDialpadScreen(hardwareReport, { navigateTo(AppRoute.CONTACTS) }, activeUiCondition)
                                      AppRoute.CONTACTS -> ContactsScreen(activeUiCondition)
                                      AppRoute.APPS_INSTALLED -> AppsGridScreen(false, storage, activeUiCondition)
                                      AppRoute.APPS_FAVORITES -> AppsGridScreen(true, storage, activeUiCondition)
                                      AppRoute.VEHICLE_INFO -> VehicleInfoScreen(telemetry, activeUiCondition)
                                      AppRoute.TRIP_DATA -> TripDataScreen(telemetry, { distanceKm = 0f; maxSpeedKmh = 0; tripStartRealtime = SystemClock.elapsedRealtime() }, activeUiCondition)
                                      AppRoute.ISLAMIC_HUB, AppRoute.PRAYER_TIMES, AppRoute.ADHKAR, AppRoute.TASBEEH, AppRoute.QIBLA, AppRoute.HIJRI_CALENDAR ->
                                          IslamicSectionScreens(currentRoute, prayers, hijriDate, storage, { navigateTo(it) }, activeUiCondition)
                                      else -> SettingsAndSystemScreens(
                                          currentRoute, storage, hardwareReport, currentPreset,
                                          onPresetChange = { currentPreset = it },
                                          onSettingsUpdated = { settingsTick++ },
                                          onNavigate = { navigateTo(it) },
                                          stateCond = activeUiCondition
                                      )
                                  }
                              }
                          }
                      }
                  }
              }
          }
          EOF

